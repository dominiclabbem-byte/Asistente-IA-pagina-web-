# Copia este archivo a .env y completa los valores
# cp .env.example .env

# API Key de Anthropic (obtén la tuya en https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Orígenes permitidos (la URL de tu sitio web, sin barra al final)
# Separa múltiples orígenes con coma
ALLOWED_ORIGINS=https://bestfoodchile.cl,https://www.bestfoodchile.cl

# Puerto del servidor (por defecto 8000)
PORT=8000
